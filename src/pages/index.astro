---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CGPA Calculator — Malaysian Public University</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<!-- ── Header ── -->
<div class="header">
  <div class="header-inner">
    <div class="header-text">
      <div class="header-tag" data-i18n="headerTag">UMS · 4.0 Scale</div>
      <h1 data-i18n="headerTitle">CGPA Calculator</h1>
      <p data-i18n="headerSub">Malaysian Public University grading system</p>
    </div>
    <!-- Language toggle -->
    <div class="lang-toggle">
      <button id="lang-en" class="lang-btn lang-active" onclick="switchLang('en')">
        <!-- UK flag -->
        <svg class="lang-flag" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
          <rect width="60" height="30" fill="#012169"/>
          <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
          <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
          <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
          <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
        </svg>
        EN
      </button>
      <button id="lang-my" class="lang-btn" onclick="switchLang('my')">
        <!-- Malaysia flag -->
        <svg class="lang-flag" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
          <!-- 14 stripes -->
          <rect width="60" height="30" fill="#fff"/>
          <rect y="0"  width="60" height="4.28" fill="#CC0001"/>
          <rect y="8.57"  width="60" height="4.28" fill="#CC0001"/>
          <rect y="17.14" width="60" height="4.28" fill="#CC0001"/>
          <rect y="25.71" width="60" height="4.28" fill="#CC0001"/>
          <!-- Blue canton -->
          <rect width="26" height="17" fill="#010066"/>
          <!-- Yellow crescent -->
          <circle cx="11" cy="8.5" r="5.2" fill="#FFCC00"/>
          <circle cx="12.5" cy="8.5" r="4" fill="#010066"/>
          <!-- Yellow star -->
          <polygon points="20,8.5 20.9,11.3 23.8,11.3 21.5,13 22.3,15.8 20,14.1 17.7,15.8 18.5,13 16.2,11.3 19.1,11.3" fill="#FFCC00" transform="scale(0.55) translate(16,6)"/>
        </svg>
        MY
      </button>
    </div>
  </div>
</div>

<!-- ── App shell ── -->
<div class="app-shell">

  <!-- ── Tab bar ── -->
  <div class="tab-bar">
    <div class="sidebar-label" data-i18n="navLabel">Navigation</div>
    <button class="tab-btn active" onclick="switchTab('sem')" id="tbtn-sem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
      <span data-i18n="navSemester">Semester</span>
    </button>
    <button class="tab-btn" onclick="switchTab('cgpa')" id="tbtn-cgpa">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      <span data-i18n="navCGPA">CGPA</span>
    </button>
    <button class="tab-btn" onclick="switchTab('target')" id="tbtn-target">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
      <span data-i18n="navTarget">Target</span>
    </button>
    <button class="tab-btn" onclick="switchTab('ref')" id="tbtn-ref">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span data-i18n="navGradeRef">Grade Ref</span>
    </button>
  </div>

  <!-- ── Main content ── -->
  <div class="main">

    <!-- ── TAB 1: Semester GPA ── -->
    <div id="tab-sem" class="tab-content active">
      <div class="content-card">
        <div class="page-title" data-i18n="semPageTitle">Semester GPA</div>
        <div class="page-subtitle" data-i18n="semPageSub">Calculate your GPA for the current semester</div>

        <div class="note-banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span data-i18n="semNote">A+ and A both carry <strong>4.00</strong> grade points per UMS grading policy.</span>
        </div>

        <div class="section-title" data-i18n="semSectionTitle">Subjects this semester</div>
        <div class="col-headers">
          <div class="col-hdr" data-i18n="colSubject">Subject</div>
          <div class="col-hdr" data-i18n="colCredit">Credit</div>
          <div class="col-hdr" data-i18n="colGrade">Grade</div>
          <div class="col-hdr"></div>
        </div>
        <div id="sem-subjects"></div>
        <button class="add-btn" onclick="addSemSubject()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span data-i18n="addSubject">+ Add subject</span>
        </button>
        <button class="calc-btn" onclick="calcSemGPA()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6M9 12h4M9 15h6"/></svg>
          <span data-i18n="calcGPA">Calculate GPA</span>
        </button>
      </div>

      <div id="sem-result" style="display:none">
        <div class="result-layout">
          <div class="result-card" id="sem-result-card">
            <div class="lbl" data-i18n="semGPALabel">Semester GPA</div>
            <div class="big" id="sem-gpa-val">0.00</div>
            <span id="sem-class-badge" class="class-badge"></span>
          </div>
          <div>
            <div class="metric-row">
              <div class="metric">
                <div class="metric-label" data-i18n="totalCredits">Total Credits</div>
                <div class="metric-value" id="sem-credits">0</div>
              </div>
              <div class="metric">
                <div class="metric-label" data-i18n="gradePoints">Grade Points</div>
                <div class="metric-value purple" id="sem-points">0.00</div>
              </div>
            </div>
            <button class="calc-btn green" onclick="exportPDF('sem')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span data-i18n="exportPDF">Export PDF</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── TAB 2: CGPA Tracker ── -->
    <div id="tab-cgpa" class="tab-content">
      <div class="content-card">
        <div class="page-title" data-i18n="cgpaPageTitle">CGPA Tracker</div>
        <div class="page-subtitle" data-i18n="cgpaPageSub">Enter each semester's GPA and credit hours</div>
        <div class="section-title" data-i18n="allSemesters">All semesters</div>
        <div class="sem-cards-grid" id="cgpa-semesters"></div>
        <button class="add-btn" style="margin-top:16px" onclick="addSemester()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span data-i18n="addSemester">+ Add semester</span>
        </button>
        <button class="calc-btn" onclick="calcCGPA()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span data-i18n="calcCGPA">Calculate CGPA</span>
        </button>
      </div>

      <div id="cgpa-result" style="display:none">
        <div class="result-layout">
          <div class="result-card">
            <div class="lbl" data-i18n="cgpaLabel">Cumulative CGPA</div>
            <div class="big" id="cgpa-val">0.00</div>
            <span id="cgpa-class-badge" class="class-badge"></span>
          </div>
          <div>
            <div class="metric-row">
              <div class="metric">
                <div class="metric-label" data-i18n="totalCreditsLbl">Total Credits</div>
                <div class="metric-value" id="cgpa-total-credits">0</div>
              </div>
              <div class="metric">
                <div class="metric-label" data-i18n="semestersLbl">Semesters</div>
                <div class="metric-value purple" id="cgpa-sem-count">0</div>
              </div>
            </div>
            <button class="calc-btn green" onclick="exportPDF('cgpa')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span data-i18n="exportPDF">Export PDF</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── TAB 3: Target Planner ── -->
    <div id="tab-target" class="tab-content">
      <div class="content-card">
        <div class="page-title" data-i18n="targetPageTitle">Target Planner</div>
        <div class="page-subtitle" data-i18n="targetPageSub">Find out the GPA you need to hit your target CGPA</div>
        <div class="target-grid">
          <div class="target-row">
            <label data-i18n="curCGPA">Current CGPA</label>
            <input type="number" id="cur-cgpa" min="0" max="4" step="0.01" placeholder="e.g. 3.20">
          </div>
          <div class="target-row">
            <label data-i18n="curCredits">Credits completed so far</label>
            <input type="number" id="cur-credits" min="0" placeholder="e.g. 80">
          </div>
          <div class="target-row">
            <label data-i18n="tgtCGPA">Target CGPA</label>
            <input type="number" id="tgt-cgpa" min="0" max="4" step="0.01" placeholder="e.g. 3.67">
          </div>
          <div class="target-row">
            <label data-i18n="remCredits">Remaining credits to complete</label>
            <input type="number" id="rem-credits" min="0" placeholder="e.g. 40">
          </div>
        </div>
        <button class="calc-btn" onclick="calcTarget()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          <span data-i18n="calcTarget">Calculate required GPA</span>
        </button>
      </div>

      <div id="target-result" style="display:none">
        <div class="result-layout">
          <div class="result-card" id="target-result-card">
            <div class="lbl" id="target-lbl" data-i18n="targetLbl">Required GPA for remaining semesters</div>
            <div class="big" id="target-val">—</div>
            <div id="target-msg" style="font-size:13px;color:rgba(255,255,255,0.8);margin-top:8px;line-height:1.5;position:relative"></div>
          </div>
          <div class="info-box" id="target-info" style="align-self:center"></div>
        </div>
      </div>
    </div>

    <!-- ── TAB 4: Grade Reference ── -->
    <div id="tab-ref" class="tab-content">
      <div class="content-card">
        <div class="page-title" data-i18n="refPageTitle">Grade Reference</div>
        <div class="page-subtitle" data-i18n="refPageSub">UMS grading scale and degree classifications</div>
        <div class="note-banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span data-i18n="refNote">A+ carries the same 4.00 grade points as A — it is an excellence recognition, not a higher GPA value.</span>
        </div>
        <div class="ref-layout">
          <div class="grade-card">
            <div class="section-title" data-i18n="gradeScale">Grade scale</div>
            <div class="grade-grid" id="grade-ref-table"></div>
          </div>
          <div class="class-card">
            <div class="section-title" data-i18n="degreeClass">Degree classification</div>
            <div class="class-list" id="class-table"></div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- end .main -->
</div><!-- end .app-shell -->

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script is:inline src="/app.js"></script>

</body>
</html>
